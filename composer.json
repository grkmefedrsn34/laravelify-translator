{
    "name": "laravelify/translator",
    "description": "Automatic Laravel translation package using Google Translate",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Laravelify\\Translator\\": "src/"
        }
    },
    "authors": [
        {
            "name": "grkmefedrsn34"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laravelify\\Translator\\TranslatorServiceProvider"
            ]
        }
    }
}
